{
  "name": "with-svelte",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm lint && pnpm check-types && pnpm test:unit && pnpm test:e2e",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "catalog:sveltejs",
    "turbo": "^2.11.4"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.20.0"
  }
}
