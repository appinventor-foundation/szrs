# Copy this to .env (not .env.local) — Docker Compose only auto-loads a file
# named exactly .env, so `docker compose up`/`down`/`logs` here pick it up
# with no extra flag. Consumed only by docker-compose.yml's ${VAR}
# interpolation. apps/llm-proxy's own env vars (LITELLM_BASE_URL,
# LITELLM_VIRTUAL_KEY, etc.) live in its own .env.local — see
# apps/llm-proxy/.env.example.

# LiteLLM admin — used only for local /key/generate bootstrapping, never
# handed to apps/llm-proxy itself. Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Used by the litellm container to actually call OpenAI.
OPENAI_API_KEY=

# LiteLLM's Langfuse callback credentials (a Langfuse project's own keys —
# LANGFUSE_INIT_* below auto-provisions a project with these same keys on
# first boot, so these two can just be made up locally).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse's own secrets. Generate each with: openssl rand -hex 32
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# Langfuse's backing stores.
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=

# Auto-provisions a Langfuse org/project/user on first boot so there's no
# manual sign-up step for local dev.
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me-too
