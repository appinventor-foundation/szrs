# Copy this to .env (not .env.local) — Docker Compose only auto-loads a file
# named exactly .env, so `docker compose up`/`down`/`logs` here pick it up
# with no extra flag. Consumed only by docker-compose.yml's ${VAR}
# interpolation. apps/llm-proxy's own env vars (LITELLM_BASE_URL,
# LITELLM_VIRTUAL_KEY, etc.) live in its own .env.local — see
# apps/llm-proxy/.env.example.

# LiteLLM admin — used only for local /key/generate bootstrapping, never
# handed to apps/llm-proxy itself. Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Used by the litellm container to actually call OpenAI.
OPENAI_API_KEY=

# Local model servers. Defaults point at Ollama / LM Studio running on this
# machine. For a machine elsewhere (e.g. over Tailscale), use its IP address:
# containers can't resolve Tailscale or .local hostnames.
# OLLAMA_MODEL=ollama/llama3.1
# OLLAMA_API_BASE=http://host.docker.internal:11434
# LMSTUDIO_API_BASE=http://host.docker.internal:1234/v1
# LMSTUDIO_API_KEY=not-needed   # set this if LM Studio requires an API token

# OpenRouter (https://openrouter.ai/keys), used by the "openrouter" model.
# Give the key a credit limit on OpenRouter's side too. OPENROUTER_MODEL must
# keep the "openrouter/" prefix, e.g. openrouter/z-ai/glm-5.3-flashx.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/z-ai/glm-5.3-flash

# LiteLLM's Langfuse callback credentials (a Langfuse project's own keys —
# LANGFUSE_INIT_* below auto-provisions a project with these same keys on
# first boot, so these two can just be made up locally).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse's own secrets. Generate each with: openssl rand -hex 32
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# Langfuse's backing stores.
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=

# Optional zoom cache (see apps/llm-proxy/README.md, "Sharing zooms between
# users"): a Redis of its own, separate from Langfuse's, that keeps finished
# zooms so the same program isn't sent to the model twice. It is in a Compose
# profile: start it with `docker compose --profile cache up -d`, or set
# COMPOSE_PROFILES=cache so a plain `docker compose up -d` includes it. Then
# set CACHE_URL in apps/llm-proxy/.env.local. Generate with: openssl rand -hex 32
# ZOOM_CACHE_AUTH=
# COMPOSE_PROFILES=cache

# Auto-provisions a Langfuse org/project/user on first boot so there's no
# manual sign-up step for local dev.
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me-too
