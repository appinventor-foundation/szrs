# Variables for docker-compose.yml in this directory. Paste these into the Dokploy
# Compose app's Environment tab (Dokploy writes them to a .env beside the
# compose file). Do not commit real values. Generate secrets with:
# openssl rand -hex 32

# Public URLs. Add a domain for each in the app's Domains tab:
#   langfuse-web -> port 3000   (LANGFUSE_URL)
#   minio        -> port 9000   (MINIO_PUBLIC_ENDPOINT; browsers upload media here)
#   dashboard    -> port 3000   (DASHBOARD_URL; better-auth's base URL and trusted origin)
#   llm-proxy    -> port 3000   (the URL the Blockly plugin is pointed at)
#   docs         -> port 80
LANGFUSE_URL=https://langfuse.example.com
MINIO_PUBLIC_ENDPOINT=https://minio.example.com
DASHBOARD_URL=https://dashboard.example.com

# Dashboard sign-in. BETTER_AUTH_SECRET signs sessions (openssl rand -hex 32).
# Registration is closed, so the first admin comes from INITIAL_ADMIN_*: the
# migrate step creates it only when no active admin exists, so the first deploy
# needs them and later deploys do not. Pick a strong password, and change it in
# the admin area (or remove these) once you can sign in.
BETTER_AUTH_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_NAME=Admin

# llm-proxy. CORS_ORIGINS: comma-separated origins of the site(s) that load
# the Blockly plugin. LITELLM_VIRTUAL_KEY: leave empty on the first deploy,
# then mint it (see the header of docker-compose.yml) and redeploy.
CORS_ORIGINS=https://app.example.com
LITELLM_VIRTUAL_KEY=
# INTERNAL_API_KEY=
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW=1 minute

LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

LITELLM_DB_PASSWORD=
LANGFUSE_DB_PASSWORD=
DASHBOARD_DB_PASSWORD=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_SECRET=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=

# Zoom cache password (the proxy and the cache share it).
ZOOM_CACHE_AUTH=
