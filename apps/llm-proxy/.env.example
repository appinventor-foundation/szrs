PORT=3000
DATABASE_URL=postgresql://llm_proxy:llm_proxy@localhost:5432/llm_proxy
INTERNAL_API_KEY=change-me

# Optional: traces are skipped if unset
OTEL_EXPORTER_OTLP_ENDPOINT=

DEPLOYMENT_ENVIRONMENT=development

# OpenAI (also used as the OpenAI-compatible adapter for hosted OpenAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Optional: any OpenAI-compatible self-hosted backend (Ollama, vLLM, TGI, ...)
SELF_HOSTED_BASE_URL=
SELF_HOSTED_MODEL=
