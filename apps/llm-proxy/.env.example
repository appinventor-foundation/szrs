PORT=3000

# Optional. When set, every request (except health checks) must send it as
# x-internal-api-key. Leave unset when the only caller is the Blockly plugin in
# a browser: a key shipped to the browser is visible to users, so it isn't a
# secret. Useful for server-to-server callers.
# INTERNAL_API_KEY=

# Comma-separated browser origins allowed to call the proxy (the site(s) that
# load the Blockly plugin). Empty means no cross-origin browser access.
# localhost:8080 is the blockly-scripts dev server.
CORS_ORIGINS=http://localhost:8080

# Requests allowed per client IP per window.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# Set to true behind a reverse proxy/load balancer, so rate limiting uses the
# client IP from X-Forwarded-For instead of the proxy's own address.
TRUST_PROXY=false

# Optional: traces are skipped if unset. infra/llm-proxy's docker-compose.yml
# runs a local Jaeger with an OTLP/HTTP receiver at this address; UI at
# localhost:16686.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

DEPLOYMENT_ENVIRONMENT=development

# LiteLLM gateway (infra/llm-proxy's docker-compose.yml runs it at :4000).
# LITELLM_VIRTUAL_KEY is minted per-consumer via /key/generate — see README
# "Bootstrapping LiteLLM".
LITELLM_BASE_URL=http://localhost:4000
LITELLM_VIRTUAL_KEY=

# Optional: keep finished zooms so the same program isn't sent to the model
# twice, for any user. Unset means no cache. Redis or Valkey; infra/llm-proxy's
# docker-compose.yml has a zoom-cache service for it (docker compose --profile
# cache up -d), with the password it takes from ZOOM_CACHE_AUTH in its .env.
# CACHE_URL=redis://:<ZOOM_CACHE_AUTH>@localhost:6380
# How long a stored zoom is reused (default 14 days). It is also how long a
# stale one lives if a model alias is pointed at a different model.
# CACHE_TTL_SECONDS=1209600
# A cache that answers slower than this counts as a miss, so it can't delay a zoom.
# CACHE_TIMEOUT_MS=500
