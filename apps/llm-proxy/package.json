{
  "name": "@szrs/llm-proxy",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/otel.js dist/index.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run test/unit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/sensible": "6.0.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@szrs/llm-proxy-contracts": "workspace:*",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "pino": "10.3.1",
    "redis": "6.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@szrs/eslint-config": "workspace:*",
    "@szrs/typescript-config": "workspace:*",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
