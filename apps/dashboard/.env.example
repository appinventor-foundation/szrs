# Copy to .env.local for `pnpm dev`. Matches the dashboard-db service in
# infra/llm-proxy/docker-compose.yml (host port 5433).
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5433/dashboard

# Signs sessions. Any 32+ character string works locally; use `openssl rand -hex 32`
# anywhere real.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# The URL you open the dashboard at. better-auth uses it as its base URL and only
# accepts sign-in requests from this origin.
DASHBOARD_URL=http://localhost:5174

# The LLM proxy (apps/llm-proxy, `pnpm dev` serves it on 3000). Only the dashboard's server
# talks to it, through the /api/szrs forwarder, so it needs no CORS and no public address.
PROXY_URL=http://localhost:3000
# The LiteLLM model alias the demo runner starts with (default openrouter).
# ZOOM_DEFAULT_MODEL=openrouter
# Only if the proxy sets INTERNAL_API_KEY.
# PROXY_API_KEY=

# `pnpm auth:seed` creates this admin if none exists yet (registration is closed).
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=dev-admin-password

# Used by the e2e tests (pnpm test:e2e) and CI; never the dev database.
TEST_DATABASE_URL=postgresql://dashboard:dashboard@localhost:5433/dashboard_test
