    "@szrs/typescript-config": "workspace:*",
    "@types/node": "26.2.0",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "playwright": "1.62.1",
    "svelte": "catalog:sveltejs",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vitest-browser-svelte": "3.0.0"
  }
